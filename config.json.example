{
  "default_language": "slovak",
  "schedule": {
    "time1": "06:00",
    "time2": "10:00",
    "time3": "14:00",
    "time4": "18:00"
  },
  "users": [
    {
    "description": "Jozef_D", "active": true, "language": "slovak", 
	"weather": {
        "locations": [
          { "location": "Bratislava,SK" },
          { "location": "Garfield,NJ,US" }
        ]
      },
	"channels": [{ "platform": "telegram", "identifier": "TELEGRAM_CHAT_ID" }],
      "subscriptions": {
        "time1": ["morning_briefing_sk", ],
        "time2": ["philosophy_mix", "european_art"],
        "time3": ["german_lesson"],
        "time4": ["family_photo"]
      }
    },
    {
      "description": "Elena_X", "active": true, "language": "slovak", 
	  "weather": { "location": "London,SK" },      
      "channels": [{ "platform": "telegram", "identifier": "TELEGRAM_CHAT_ID" }],
      "subscriptions": { 
	  "time1": ["morning_briefing_sk"], 
	  "time2": ["bible_sk"], 
	  "time3": ["novy_zakon_sk"], 
	  "time4": ["stary_zakon_sk"] }
    },
    {
      "description": "Maria_Z", "active": true, "language": "slovak", 
	  "weather": { "location": "Munchen,SK" },
      "channels": [{ "platform": "telegram", "identifier": "TELEGRAM_CHAT_ID" }],
      "subscriptions": {
        "time1": ["morning_briefing_sk", "bible_sk"],
        "time2": ["philosophy_mix", "european_art", "family_photo"],
        "time3": ["german_lesson"],
        "time4": ["novy_zakon_sk", "stary_zakon_sk"]
      }
    }
  ],
  "themes": {
    "bible_sk": {
      "handler_class": "BibleHandler",
      "data_source": { "spreadsheet_key": "YDP_LLM_Static_Spiritual", "worksheet_key": "bible_sk" },
      "dynamic_image": { "provider": "unsplash", "query": "nature,light,hope,spiritual,calm,faith" },
      "prompts": { "slovak": "src/resources/llm/prompt_bible_slovak.txt" }
    },
    "bible_en": {
      "handler_class": "BibleHandler",
      "data_source": { "spreadsheet_key": "YDP_LLM_Static_Spiritual", "worksheet_key": "bible_en" },
      "dynamic_image": { "provider": "unsplash", "query": "nature,light,hope,spiritual,calm,faith" },
      "prompts": { "english": "src/resources/llm/prompt_bible_english.txt" }
    },
    "philosophy_mix": {
      "handler_class": "PhilosophyHandler",
      "data_source": { "spreadsheet_key": "YDP_LLM_Static_Spiritual", "worksheet_key": "philosophy_sk" },
      "dynamic_image": { "provider": "unsplash", "query": "minimalist,black and white,architecture,shadow,thinking,abstract,solitude" },
      "prompts": { "slovak": "src/resources/llm/prompt_philosophy_mix_slovak.txt" }
    },
    "stary_zakon_sk": {
      "handler_class": "BibleStudyHandler",
      "data_source": { "spreadsheet_key": "YDP_LLM_Static_Spiritual", "worksheet_key": "stary_zakon_sk" },
      "testament_name": "StarÃ½ zÃ¡kon",
      "dynamic_image": { "provider": "unsplash", "query": "ancient,scroll,history,manuscript,stone,israel" },
      "prompts": { "slovak": "src/resources/llm/prompt_bible_study_slovak.txt" }
    },
    "novy_zakon_sk": {
      "handler_class": "BibleStudyHandler",
      "data_source": { "spreadsheet_key": "YDP_LLM_Static_Spiritual", "worksheet_key": "novy_zakon_sk" },
      "testament_name": "Nový zákon",
      "dynamic_image": { "provider": "unsplash", "query": "hope,light,scroll,ancient,history,spiritual" },
      "prompts": { "slovak": "src/resources/llm/prompt_bible_study_slovak.txt" }
    },
    "family_photo": {
      "handler_class": "SimpleStaticHandler",
      "data_source": { "spreadsheet_key": "YDP_Simple_Static_Family", "worksheet_key": "family_photos" },
      "prompts": { "slovak": "src/resources/template/family_photo_slovak.txt" }
    },
    "european_art": {
      "handler_class": "SimpleStaticHandler",
      "data_source": { "spreadsheet_key": "YDP_Simple_Static_Art", "worksheet_key": "european_art" },
      "prompts": { "slovak": "src/resources/template/european_art_slovak.txt" }
    },
    "morning_briefing_sk": {
      "handler_class": "LLMDynamicHandler",
	  "processing_strategy": "per_user",
      "content_rotation_source": { "spreadsheet_key": "YDP_LLM_Dynamic_MorningBriefing", "worksheet_key": "rotation" },
      "dynamic_image": { "provider": "unsplash", "query": "nature,wallpaper,calm,minimalist,landscape" },
      "components": { "name_day": true, "daily_greeting": true },
      "prompts": { "slovak": "src/resources/llm/prompt_morning_briefing_slovak.txt" }
    },
    "german_lesson": {
      "handler_class": "DynamicTemplateHandler",
      "static_image_nouns_url": "https://res.cloudinary.com/..../image1.png",
      "static_image_adjectives_url": "https://res.cloudinary.com/..../image2.png",
      "static_image_adverbs_url": "https://res.cloudinary.com/.../image3.png",
      "static_image_prepositions_url": "https://res.cloudinary.com/.../image4.png",
      "static_image_pronouns_url": "https://res.cloudinary.com/.../image5.png",
      "static_image_verbs_irregular_url": "https://res.cloudinary.com/../image6.png",
      "static_image_verbs_regular_url":  "https://res.cloudinary.com/.../image7.png",
      "content_rotation_source": { "spreadsheet_key": "YDP_LLM_Dynamic_GermanLesson", "worksheet_key": "rotation" },
      "prompts": {
        "slovak": {
          "verbs": "src/resources/template/german_lesson_verbs_slovak.txt",
          "other": "src/resources/template/german_lesson_other_slovak.txt"
        }
      }
    }
  },
  "data_sources": {
    "YDP_System": {
      "spreadsheet_url": "https://docs.google.com/spreadsheets/d/..../edit",
      "worksheets": { "jobs": "Jobs" }
    },
    "YDP_LLM_Static_Spiritual": {
      "spreadsheet_url": "https://docs.google.com/spreadsheets/d/..../edit",
      "worksheets": { "bible_sk": "BibleSk", "bible_en": "BibleEng", "philosophy_sk": "PhilosophySk", "novy_zakon_sk": "NovyZakonSk", "stary_zakon_sk": "StaryZakonSk" }
    },
    "YDP_Simple_Static_Family": {
      "spreadsheet_url": "https://docs.google.com/spreadsheets/d/..../edit",
      "worksheets": { "family_photos": "FamilyPhotos" }
    },
    "YDP_Simple_Static_Art": {
      "spreadsheet_url": "https://docs.google.com/spreadsheets/d/..../edit",
      "worksheets": { "european_art": "EuArt" }
    },
    "YDP_LLM_Dynamic_MorningBriefing": {
      "spreadsheet_url": "https://docs.google.com/spreadsheets/d/..../edit",
      "worksheets": {
        "rotation": "Rotation", "meniny_sk": "meninySk", "daily_greetings": "DailyGreetings",
        "historical_events": { "name": "HistoricalEvents", "header": "<b>🏛️ Today in history:</b>" },
        "fun_facts": { "name": "FunFacts", "header": "<b>💡 Interestingness:</b>" },
        "quotes": { "name": "Quotes", "header": "<b>✒️ Quote of the day:</b>" },
        "reflections": { "name": "Reflections", "header": "<b>🤔 Food for thought:</b>" },
        "challenges": { "name": "Challenges", "header": "<b>🎯 Today's micro-challenge:</b>" },
        "perspectives": { "name": "Perspectives", "header": "<b>✨ Perspective of the day:</b>" },
        "word_of_the_day": { "name": "WordOfTheDay", "header": "<b>📖 Word of the day:</b>" }
      }
    },
    "YDP_LLM_Dynamic_GermanLesson": {
      "spreadsheet_url": "https://docs.google.com/spreadsheets/d/..../edit",
      "worksheets": {
        "rotation": "Rotation", "slow_german_links": "SlowGermanLinks",
        "01_nouns_de": "01_nouns_de", "02_verbs_irregular_de": "02_verbs_irregular_de",
        "02_verbs_regular_de": "02_verbs_regular_de", "03_adjectives_de": "03_adjectives_de",
        "04_pronouns_de": "04_pronouns_de", "05_adverbs_de": "05_adverbs_de",
        "06_prepositions_de": "06_prepositions_de"
      }
    }
  }
}